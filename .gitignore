# ==============================================================================
# SVCA System — Comprehensive Git Ignore Configuration
# Production-ready gitignore for React + Vite + TypeScript + Tailwind CSS
# ==============================================================================

# --------------------------------------------------
# Dependencies
# --------------------------------------------------
node_modules/
/.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/

# --------------------------------------------------
# Production Build Outputs & Artifacts
# --------------------------------------------------
dist/
dist-ssr/
build/
out/
*.local

# --------------------------------------------------
# TypeScript & Build Caches
# --------------------------------------------------
*.tsbuildinfo
tsconfig.tsbuildinfo
.eslintcache
.stylelintcache
.prettiercache

# --------------------------------------------------
# Vite, Vitest & Tooling Caches
# --------------------------------------------------
.vite/
.vitest/
.cache/
.tmp/
.temp/

# --------------------------------------------------
# Environment Variables & Private Credentials
# (Never commit actual API keys or secret env files)
# --------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# --------------------------------------------------
# Runtime Logs & Diagnostics
# --------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
vite.log

# --------------------------------------------------
# Test Coverage & Reports
# --------------------------------------------------
coverage/
*.lcov
.nyc_output/

# --------------------------------------------------
# Operating System Junk Files
# --------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.directory

# --------------------------------------------------
# IDE & Code Editor Settings
# --------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
